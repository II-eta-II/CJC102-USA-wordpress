# WordPress Environment Variables Template
# 複製此檔案為 .env 並填入實際值（.env 不會被提交到 Git）

# WordPress Database Configuration
WORDPRESS_DB_HOST=db
WORDPRESS_DB_USER=root
WORDPRESS_DB_PASSWORD=rootpassword
WORDPRESS_DB_NAME=wordpress

# WordPress Debug Mode
WORDPRESS_DEBUG=true

# CWA API Token (中央氣象署 API 金鑰)
# 請到 https://opendata.cwa.gov.tw/ 申請您的 API Token
CWA_API_TOKEN=your-cwa-token-here

# WordPress Security Keys (in production, generate unique keys)
# Visit https://api.wordpress.org/secret-key/1.1/salt/ to generate
WORDPRESS_AUTH_KEY=your-unique-phrase
WORDPRESS_SECURE_AUTH_KEY=your-unique-phrase
WORDPRESS_LOGGED_IN_KEY=your-unique-phrase
WORDPRESS_NONCE_KEY=your-unique-phrase
WORDPRESS_AUTH_SALT=your-unique-phrase
WORDPRESS_SECURE_AUTH_SALT=your-unique-phrase
WORDPRESS_LOGGED_IN_SALT=your-unique-phrase
WORDPRESS_NONCE_SALT=your-unique-phrase
